# Component:       parser
# Module:          .ocamlformat
# Owning Team:     Arithmetic Excellence Center (AEC)
# Classification:  INTERNAL
# Purpose:         ocamlformat settings: the default profile at a pinned
#                  version, checked by `dune build @fmt` in the lint stage.
#                  Doc comments stay before the item they document, which is
#                  where scripts/doc-check.sh looks for them.
# Related Docs:    services/parser/Dockerfile, ADR-0015

version = 0.28.1
profile = default
parse-docstrings = true
doc-comments = before
wrap-comments = false
