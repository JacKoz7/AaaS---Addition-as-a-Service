# SPDX-License-Identifier: MIT
# Copyright (c) 2026 AaaS Contributors
#
# Component:       parser
# Module:          aaas_parser.opam
# Owning Team:     Arithmetic Excellence Center (AEC)
# Classification:  INTERNAL
# Purpose:         opam dependencies of the parser service, every one pinned
#                  to an exact version; installed by the Dockerfile
#                  toolchain stage with `opam install --deps-only`.
#                  ocamlformat is marked with-test because opam 2.0 (the
#                  version of the base image) has no with-dev-setup filter.
# Related Docs:    services/parser/Dockerfile, ADR-0015

opam-version: "2.0"
version: "0.1.0"
synopsis: "AaaS parser: turns the text expression into an AST"
maintainer: "AaaS Contributors"
authors: "AaaS Contributors"
license: "MIT"
homepage: "https://github.com/JacKoz7/AaaS---Addition-as-a-Service"
bug-reports: "https://github.com/JacKoz7/AaaS---Addition-as-a-Service/issues"
depends: [
  "ocaml" {= "4.14.2"}
  "dune" {= "3.20.2"}
  "kafka" {= "0.5"}
  "kafka_lwt" {= "0.5"}
  "lwt" {= "5.9.2"}
  "cohttp-lwt-unix" {= "6.1.1"}
  "sqlite3" {= "5.3.1"}
  "yojson" {= "3.0.0"}
  "alcotest" {with-test & = "1.9.1"}
  "alcotest-lwt" {with-test & = "1.9.1"}
  "ocamlformat" {with-test & = "0.28.1"}
  "odoc" {with-doc & = "3.1.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
